  "type": "module",
  "license": "MIT",
  "author": "AK-103U",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "tui",
    "localization",
    "notification"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AK-103U/pi-ui-plus.git"
  },
  "homepage": "https://github.com/AK-103U/pi-ui-plus#readme",
  "bugs": {
    "url": "https://github.com/AK-103U/pi-ui-plus/issues"
  },
  "files": [
    "pi-ui-plus",
    "pi-agent-notify.ts",
    "assets",
    "docs",
    "LICENSE",
    "README_en.md"
  ],
  "pi": {
    "extensions": [
      "./pi-ui-plus/index.ts",
      "./pi-agent-notify.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
